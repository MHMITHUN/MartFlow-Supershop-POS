# Copy this file to ".env" and fill in your values. The ".env" file is gitignored.
# NEVER commit your real connection string or password. Keep this file as a template only.

# MongoDB Atlas connection string (from Atlas -> Connect -> Drivers).
# Contains user:password, so treat it as a secret. Put the real value ONLY in .env.
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Database name inside the Atlas cluster.
MONGODB_DB=shop
