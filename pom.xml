<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.0</version>
        <relativePath/>
    </parent>

    <groupId>com.martflow</groupId>
    <artifactId>martflow</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>martflow</name>
    <description>MartFlow - Supershop Retail Management Suite</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- REST API + embedded Tomcat + Jackson + logging (the only Spring piece; patterns are pure POJO) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- MongoDB Atlas access via the raw sync driver, adapted by our Repositories (Adapter pattern).
             Version is managed by the Spring Boot BOM so the driver matches what the framework expects. -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>mongodb-driver-sync</artifactId>
        </dependency>

        <!-- Tests: JUnit 5 + MockMvc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Tests must never touch a real database: point MONGODB_URI at an invalid
                         value so DatabaseConnection falls back to the in-memory repositories.
                         (A developer's local .env would otherwise leak a live Atlas URI in.) -->
                    <environmentVariables>
                        <MONGODB_URI>surefire-hermetic-do-not-connect</MONGODB_URI>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
